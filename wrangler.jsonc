{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chickenstrike2servers",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "assets": {
    "directory": "./game",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/invite/*"]
  }
}
