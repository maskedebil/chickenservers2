
const ROOM_LENGTH = 6;
const ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

function makeCode() {
  const bytes = crypto.getRandomValues(new Uint8Array(ROOM_LENGTH));
  return [...bytes].map(b => ALPHABET[b % ALPHABET.length]).join("");
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "POST" && url.pathname === "/api/rooms") {
      let code;
      let room;

      for (let i = 0; i < 10; i++) {
        code = makeCode();
        room = env.ROOMS.get(env.ROOMS.idFromName(code));
        const result = await room.fetch("https://room/create", {
          method: "POST"
        });
        if (result.status === 201) break;
        code = null;
      }

      if (!code) {
        return Response.json({ error: "Could not create room" }, { status: 500 });
      }

      const base = `${url.protocol}//${url.host}`;

      return Response.json({
        room: code,
        inviteUrl: `${base}/invite/${code}`,
        wsUrl: `${url.protocol === "https:" ? "wss:" : "ws:"}//${url.host}/ws?room=${code}`,
        expiresAt: Date.now() + 86400000
      }, { status: 201 });
    }

    if (url.pathname.startsWith("/api/rooms/")) {
      const code = url.pathname.split("/").pop().toUpperCase();
      const room = env.ROOMS.get(env.ROOMS.idFromName(code));
      return room.fetch("https://room/meta");
    }

    if (url.pathname.startsWith("/invite/")) {
      const code = url.pathname.split("/").pop().toUpperCase();
      return Response.redirect(`${url.origin}/game/?room=${code}`, 302);
    }

    if (url.pathname === "/ws") {
      const code = (url.searchParams.get("room") || "").toUpperCase();
      if (!code) return new Response("Room code required", { status: 400 });

      const room = env.ROOMS.get(env.ROOMS.idFromName(code));
      return room.fetch("https://room/ws", request);
    }

    if (env.ASSETS) {
      const assetUrl = new URL(request.url);
      if (assetUrl.pathname.startsWith("/game/")) {
        assetUrl.pathname = assetUrl.pathname.slice(5) || "/";
      }
      return env.ASSETS.fetch(new Request(assetUrl, request));
    }

    return new Response("ChickenStrike2Servers is running!");
  }
};

export class Room {
  constructor(state) {
    this.state = state;
  }

  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/create" && request.method === "POST") {
      const existing = await this.state.storage.get("room");
      if (existing && existing.expiresAt > Date.now()) {
        return new Response("Already exists", { status: 409 });
      }

      await this.state.storage.put("room", {
        createdAt: Date.now(),
        expiresAt: Date.now() + 86400000
      });

      return new Response("Created", { status: 201 });
    }

    if (url.pathname === "/meta") {
      const room = await this.state.storage.get("room");

      if (!room || room.expiresAt <= Date.now()) {
        return Response.json({ error: "Room not found or expired" }, { status: 404 });
      }

      return Response.json(room);
    }

    if (url.pathname === "/ws") {
      const room = await this.state.storage.get("room");

      if (!room || room.expiresAt <= Date.now()) {
        return new Response("Room expired", { status: 404 });
      }

      if (request.headers.get("Upgrade") !== "websocket") {
        return new Response("Expected WebSocket", { status: 426 });
      }

      const pair = new WebSocketPair();
      const client = pair[0];
      const server = pair[1];

      this.state.acceptWebSocket(server);

      return new Response(null, {
        status: 101,
        webSocket: client
      });
    }

    return new Response("Not found", { status: 404 });
  }

  webSocketMessage(sender, message) {
    for (const socket of this.state.getWebSockets()) {
      if (socket !== sender) {
        try {
          socket.send(message);
        } catch (_) {}
      }
    }
  }

  webSocketClose(socket) {
    try {
      socket.close();
    } catch (_) {}
  }
}
